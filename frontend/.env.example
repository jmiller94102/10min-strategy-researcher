# Frontend Environment Variables - 10-K Dashboard

# =============================================================================
# API CONFIGURATION
# =============================================================================
# Backend API base URL (FastAPI server)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# WebSocket URL (for real-time pipeline updates)
VITE_WS_URL=ws://localhost:8000/ws

# =============================================================================
# APPLICATION
# =============================================================================
VITE_APP_NAME=10-K AI Intelligence Dashboard
VITE_ENVIRONMENT=development

# =============================================================================
# FEATURE FLAGS (Optional)
# =============================================================================
# Toggle between mock data and real API
VITE_ENABLE_MOCK_DATA=true  # Set to false when backend is ready

# Enable debug logging
VITE_ENABLE_DEBUG=true

# =============================================================================
# MOCK DATA CONFIGURATION (for development)
# =============================================================================
# Number of mock companies to generate
VITE_MOCK_COMPANY_COUNT=3

# =============================================================================
# NOTES
# =============================================================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Update VITE_API_BASE_URL if backend runs on different port
# 3. Set VITE_ENABLE_MOCK_DATA=false when ready to use real backend
# 4. All Vite env vars must start with VITE_ to be exposed to browser
# 5. Restart dev server after changing .env (npm run dev)
#
# Frontend-Backend Connection:
# - Frontend (Vite): http://localhost:3000
# - Backend (FastAPI): http://localhost:8000
# - WebSocket: ws://localhost:8000/ws

# ============================================================================
# 10-K AI Intelligence Pipeline - Frontend Environment Configuration
# ============================================================================

# ----------------------------------------------------------------------------
# API MODE CONFIGURATION
# ----------------------------------------------------------------------------

# Choose ONE of three modes:
#
# 1. CLIENT_MOCK: Client-side simulation (no backend required)
#    - Fast development
#    - No HTTP requests
#    - Uses src/mocks/mockData.ts
#
# 2. BACKEND_MOCK: Backend /mock/* endpoints (backend mock endpoints)
#    - Tests real HTTP requests
#    - Tests CORS configuration
#    - Backend must implement /mock/* endpoints
#    - Recommended for integration testing
#
# 3. REAL: Production backend endpoints
#    - Full backend pipeline required
#    - All features enabled
#    - Production deployment

# Current mode (uncomment ONE):
VITE_API_MODE=CLIENT_MOCK
# VITE_API_MODE=BACKEND_MOCK
# VITE_API_MODE=REAL

# ----------------------------------------------------------------------------
# API ENDPOINTS
# ----------------------------------------------------------------------------

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8000/api/v1

# WebSocket URL
VITE_WS_URL=ws://localhost:8000/ws

# ----------------------------------------------------------------------------
# FEATURE FLAGS
# ----------------------------------------------------------------------------

# Enable debug mode (verbose logging)
VITE_ENABLE_DEBUG=true

# Environment
VITE_ENVIRONMENT=development

# Application name
VITE_APP_NAME="10-K AI Intelligence Dashboard"

# ----------------------------------------------------------------------------
# LEGACY SUPPORT (deprecated - use VITE_API_MODE instead)
# ----------------------------------------------------------------------------

# VITE_ENABLE_MOCK_DATA=true  # Legacy: Maps to CLIENT_MOCK mode

# ============================================================================
# CONFIGURATION GUIDE
# ============================================================================

# Development Workflow:
# ----------------------
# 1. Start with CLIENT_MOCK mode (default)
#    - Fastest development
#    - No backend dependency
#    - Work on UI/UX
#
# 2. Switch to BACKEND_MOCK when backend /mock/* endpoints are ready
#    - Test HTTP integration
#    - Test CORS setup
#    - Validate serialization
#
# 3. Switch to REAL when full backend is complete
#    - Test end-to-end flow
#    - Validate real data
#    - Performance testing

# Backend Mock Endpoints (BACKEND_MOCK mode):
# -------------------------------------------
# Backend team should implement these endpoints:
#
# GET  /api/v1/mock/companies/{ticker}
# POST /api/v1/mock/pipeline/start
# GET  /api/v1/mock/pipeline/status/{job_id}
# GET  /api/v1/mock/pipeline/results/{job_id}
# GET  /api/v1/mock/companies
# GET  /api/v1/mock/comparison?tickers=...
# POST /api/v1/mock/export/salesforce
# POST /api/v1/mock/export/playbooks
# GET  /api/v1/mock/health
#
# These should return realistic mock data instantly (no processing)

# Production Deployment (REAL mode):
# -----------------------------------
# VITE_API_MODE=REAL
# VITE_API_BASE_URL=https://api.yourdomain.com/api/v1
# VITE_WS_URL=wss://api.yourdomain.com/ws
# VITE_ENABLE_DEBUG=false
# VITE_ENVIRONMENT=production

# ============================================================================

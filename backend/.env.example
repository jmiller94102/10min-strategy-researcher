# Backend Environment Variables - 10-K AI Intelligence Pipeline

# =============================================================================
# ENVIRONMENT
# =============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# =============================================================================
# AZURE OPENAI CONFIGURATION
# =============================================================================
# Get these from: Azure Portal > Azure OpenAI Service > Keys and Endpoint
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Model Deployments (you need both for different tasks)
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o  # For LLM analysis/extraction
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small  # For embeddings (if needed)

# Alternative: OpenAI (if not using Azure)
# OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=api-key-here

# =============================================================================
# GALILEO OBSERVABILITY (OPTIONAL)
# =============================================================================
# Get API key from: https://app.galileo.ai/onboarding/start-logging
# Galileo provides LLM observability, tracking, and evaluation
GALILEO_API_KEY=your-galileo-api-key-here
GALILEO_PROJECT=10K-Pipeline
GALILEO_LOG_STREAM=production
GALILEO_CONSOLE_URL=https://app.galileo.ai

# =============================================================================
# DAYTONA CONFIGURATION
# =============================================================================
# Get API key from: https://app.daytona.io/settings/api-keys
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_API_KEY=your-daytona-api-key-here
DAYTONA_TARGET=us
DAYTONA_WORKSPACE_PREFIX=10k-pipeline
DAYTONA_MAX_ENVIRONMENTS=10

# =============================================================================
# BROWSER-USE CONFIGURATION
# =============================================================================
# Browser-Use settings
BROWSER_HEADLESS=true  # Set to false for debugging
BROWSER_TIMEOUT=30000  # 30 seconds timeout
SEC_REQUEST_DELAY=1  # Seconds between SEC requests (avoid rate limiting)

# =============================================================================
# CACHING
# =============================================================================
ENABLE_CACHING=true
CACHE_DIR=./cache
CACHE_TTL_DAYS=30  # Cache 10-Ks for 30 days

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
FRONTEND_URL=http://localhost:3000

# =============================================================================
# RATE LIMITING
# =============================================================================
LLM_CALLS_PER_MINUTE=50
SEC_REQUESTS_PER_SECOND=10

# =============================================================================
# API SERVER
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8010

# =============================================================================
# DATABASE (OPTIONAL - for production)
# =============================================================================
# DATABASE_URL=postgresql://user:password@localhost:5432/tenk_intelligence

# =============================================================================
# NOTES
# =============================================================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in your actual API keys
# 3. Never commit .env to git (it's in .gitignore)
#
# How to get credentials:
# - Azure OpenAI: https://portal.azure.com → Create Azure OpenAI resource
# - Daytona: https://app.daytona.io → Settings → API Keys
# - Galileo: https://app.galileo.ai/onboarding/start-logging → Get API Key
# - Browser-Use: No API key needed (uses local browser)
